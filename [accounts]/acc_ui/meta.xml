<meta>
    <info author="DrAndrew112" name="Account UI" version="1.0.0" type="script"
          description="Login / register / password reset / ban panels, news and weekly cards, menu music, backgrounds" />

    <include resource="v_locals" />
    <include resource="ui_core" />
    <include resource="dgs" />
    <include resource="acc_auth" />

    <script src="locals.lua" type="shared" />

    <!-- ================= CLIENT ================= -->
    <script src="client/state.lua" type="client" />
    <script src="client/theme.lua" type="client" />
