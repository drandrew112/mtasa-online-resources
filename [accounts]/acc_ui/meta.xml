    <script src="client/panels/banned.lua" type="client" />

    <!-- ================= SERVER ================= -->
    <script src="server/feed.lua" type="server" />

    <!-- Menu music for acc_menu: setMusicActive(on) keeps it playing while no
         acc_ui panel is up; isMusicEnabled() / setMusicEnabled(bool) = the player's choice.
         getBackgroundImage() -> path of this session's background (":acc_ui/bgs/N.png") -->
    <export function="setMusicActive"     type="client" />
    <export function="isMusicEnabled"     type="client" />
    <export function="setMusicEnabled"    type="client" />
    <export function="getBackgroundImage" type="client" />

