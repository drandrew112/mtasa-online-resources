    <script src="shared/config.lua" type="shared" />

    <!-- ================= SERVER ================= -->
    <script src="server/tickets.lua" type="server" />
    <script src="server/rail.lua"    type="server" />

    <!-- ================= CLIENT ================= -->
    <script src="client/panel.lua" type="client" />
    <file src="fonts/Roboto.ttf"   type="client" />
    <file src="fonts/RobotoB.ttf"  type="client" />

    <!-- ================= EXPORTS ================= -->
    <export function="getTicket"       type="server" />
    <export function="hasValidTicket"  type="server" />
