# --- TikTok integráció (bridge, node_modules, titkok) ---
# A szögletes zárójel a gitignore-ban karakterosztály, ezért escape-elni kell,
# különben csak az egykarakteres "t"/"i"/"k"/"o" nevű mappákra illeszkedne.
/\[tiktok\]/

# --- Futásidőben generált adatfájlok (személyes adat, ne kerüljön verziózásba) ---
/\[core\]/v_accounts/bans.xml
/\[player_interaction\]/v_socialpanel/crews.xml
/\[player_interaction\]/v_socialpanel/messages.xml

# --- Models ---
/\[core\]/v_modloader/

# --- v_ownveh: futásidejű járműadatbázis + a /vehspawn gyűjtőfájl ---
# (a spawnpoints.lua kézzel karbantartott, ezért verziózódik)
/\[vehicles\]/v_ownveh/vehicles.db
/\[vehicles\]/v_ownveh/vehicles.db-journal
/\[vehicles\]/v_ownveh/vehicles.db-wal
/\[vehicles\]/v_ownveh/vehicles.db-shm
/\[vehicles\]/v_ownveh/vehiclespawnpoints.txt

# --- MySQL: csak a hitelesítő adatokat tartó config.lua marad ki ---
# (a többi fájl - core, scripts, config.example.lua, database.sql - verziózódik)
/\[core\]/v_mysql/config.lua

# --- Szerkesztői / backup szemét ---
*.old
*.bak
*.orig
*~
Thumbs.db
desktop.ini
