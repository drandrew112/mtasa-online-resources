# --- TikTok integration (bridge, node_modules, secrets) ---
# Square brackets are a character class in gitignore, so they must be escaped,
# otherwise this would only match single-character folders named "t"/"i"/"k"/"o".
/\[tiktok\]/

# --- Runtime-generated data files (personal data, keep out of version control) ---
/\[core\]/v_accounts/bans.xml
# v_socialpanel crew/message/friend-request data now lives in the shared MySQL
# database; these files may only linger from old installs.
/\[player_interaction\]/v_socialpanel/crews.xml
/\[player_interaction\]/v_socialpanel/messages.xml

# --- Models ---
# --- v_modloader: the script is versioned; model files, the generated meta.xml and logs are not ---
# (only meta.changethis.xml is in the repo - /modloader update builds meta.xml from it)
/\[core\]/v_modloader/meta.xml
/\[core\]/v_modloader/meta.new.xml
/\[core\]/v_modloader/logs/
/\[core\]/v_modloader/vehicles/*
/\[core\]/v_modloader/skins/*
/\[core\]/v_modloader/weapons/*
/\[core\]/v_modloader/objects/*
!/\[core\]/v_modloader/*/.gitkeep

# --- v_ownveh: the /vehspawn collector file ---
# (spawnpoints.lua is hand-maintained, so it is versioned; vehicle data now
#  lives in the shared MySQL database, not a local vehicles.db)
/\[vehicles\]/v_ownveh/vehiclespawnpoints.txt

# --- v_customs: archive of the old SA Customs code, not to be versioned ---
/\[vehicles\]/v_customs/old/

# --- MySQL: only the config.lua holding the credentials is excluded ---
# (the other files - core, scripts, config.example.lua, database.sql - are versioned)
/\[core\]/v_mysql/config.lua

# --- medsys: reference materials, not to be versioned ---
/\[medical\]/medsys/reference/

# --- claude-mcp: Node.js dependencies and saved screenshots ---
/\[devtools\]/claude-mcp/
/\[devtools\]/claude-mcp/mcp-server/node_modules/
/\[devtools\]/claude-mcp/screenshots/
/\[devtools\]/takeapic/

# --- railway logs ---
/\[railways\]/rw_core/logs/

# --- v_modmenu: freeroam-based mod menu, local/dev only (never on the public server, ISSUES.md SEC-04) ---
/v_modmenu/

# --- Editor / backup junk ---
*.old
*.bak
*.orig
*~
Thumbs.db
desktop.ini

# --- med_scenemanager: runtime variety history (auto-created) ---
/\[medical\]/med_scenemanager/data/variety.json


# --- v_discordmanager: webhook URLs (secrets); webhooks.example.json is versioned ---
/\[core\]/v_discordmanager/webhooks.json

# --- v_main: per-instance server identity (copy server.example.json) ---
/\[core\]/v_main/server.json

# --- acc_auth password reset mailer: SMTP credentials + API key ---
/\[accounts\]/acc_auth/web/forgotpasswd.config.php
/\[accounts\]/acc_auth/config.lua
