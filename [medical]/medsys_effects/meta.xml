<meta>
    <info author="DrAndrew112" name="medsys_effects" version="1.0" type="script" description="What a player experiences from their medical state (screen, controls, walking) and the forced patient animations of players and peds" />
    <min_mta_version server="1.5.8" client="1.5.8" />

    <!-- the medical state comes from here -->
    <include resource="medsys" />

    <script src="shared/config.lua" type="shared" />

    <script src="server/state.lua" type="server" />
    <script src="server/exports.lua" type="server" />
    <script src="server/test.lua" type="server" /> <!-- only runs when MEDFX_TEST.ENABLED -->

    <script src="client/anim.lua" type="client" />
    <script src="client/effects.lua" type="client" />
    <script src="client/test.lua" type="client" /> <!-- only runs when MEDFX_TEST.ENABLED -->

    <file src="assets/fonts/Roboto.ttf" type="client" />
    <file src="assets/fonts/RobotoB.ttf" type="client" />

    <!-- forced animations: another script can take a patient over (carry, seat ...) -->
    <export function="setAnimationBlocked" type="server" />
    <export function="isAnimationBlocked" type="server" />
    <export function="getForcedAnimation" type="server" />
</meta>
