<meta>
    <info author="DrAndrew112" name="mg_cast" version="1.0" type="script" description="Plaster cast minigame (roll the bandage on the rhythm, keep the overlap), driven through exports" />
    <min_mta_version client="1.5.8" />

    <include resource="v_locals" />
    <script src="locals.lua" type="shared" />
    <script src="shared.lua" type="shared" />
    <script src="kit/client.lua" type="client" />
    <script src="client.lua" type="client" />
    <script src="kit/server.lua" type="server" />
    <script src="server.lua" type="server" />

    <!-- server: start/stop the game for a player, result arrives via onCastGameFinish -->
    <export function="startCastGame" type="server" />
    <export function="stopCastGame" type="server" />
    <export function="isCastGameActive" type="server" />

    <!-- client: local-only game, result arrives via onClientCastGameFinish -->
    <export function="startCastGame" type="client" />
    <export function="stopCastGame" type="client" />
    <export function="isCastGameActive" type="client" />
</meta>
