<meta>
    <info author="DrAndrew112" name="mg_reduction" version="1.0" type="script" description="Fracture reduction minigame under fluoroscopy (traction, shift, rotation), driven through exports" />
    <min_mta_version client="1.5.8" />

    <include resource="v_locals" />
    <script src="locals.lua" type="shared" />
    <script src="shared.lua" type="shared" />
    <script src="kit/client.lua" type="client" />
    <script src="client.lua" type="client" />
    <script src="kit/server.lua" type="server" />
    <script src="server.lua" type="server" />

    <!-- server: start/stop the game for a player, result arrives via onReductionGameFinish -->
    <export function="startReductionGame" type="server" />
    <export function="stopReductionGame" type="server" />
    <export function="isReductionGameActive" type="server" />

    <!-- client: local-only game, result arrives via onClientReductionGameFinish -->
    <export function="startReductionGame" type="client" />
    <export function="stopReductionGame" type="client" />
    <export function="isReductionGameActive" type="client" />
</meta>
