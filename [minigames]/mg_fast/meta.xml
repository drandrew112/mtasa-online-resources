<meta>
    <info author="DrAndrew112" name="mg_fast" version="1.0" type="script" description="FAST / eFAST bedside ultrasound minigame (probe windows, tilt, live picture), driven through exports" />
    <min_mta_version client="1.5.8" />

    <include resource="v_locals" />
    <script src="locals.lua" type="shared" />
    <script src="shared.lua" type="shared" />
    <script src="kit/client.lua" type="client" />
    <script src="client.lua" type="client" />
    <script src="kit/server.lua" type="server" />
    <script src="server.lua" type="server" />

    <!-- server: start/stop the game for a player, result arrives via onFastGameFinish -->
    <export function="startFastGame" type="server" />
    <export function="stopFastGame" type="server" />
    <export function="isFastGameActive" type="server" />

    <!-- client: local-only game, result arrives via onClientFastGameFinish -->
    <export function="startFastGame" type="client" />
    <export function="stopFastGame" type="client" />
    <export function="isFastGameActive" type="client" />
</meta>
