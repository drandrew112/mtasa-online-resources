<meta>
    <info author="DrAndrew112" name="mg_blooddraw" version="1.0" type="script" description="Venous blood sampling minigame (tourniquet, puncture, order of draw), driven through exports" />
    <min_mta_version client="1.5.8" />

    <include resource="v_locals" />
    <script src="locals.lua" type="shared" />
    <script src="shared.lua" type="shared" />
    <script src="kit/client.lua" type="client" />
    <script src="client.lua" type="client" />
    <script src="kit/server.lua" type="server" />
    <script src="server.lua" type="server" />

    <!-- server: start/stop the game for a player, result arrives via onBloodDrawGameFinish -->
    <export function="startBloodDrawGame" type="server" />
    <export function="stopBloodDrawGame" type="server" />
    <export function="isBloodDrawGameActive" type="server" />

    <!-- client: local-only game, result arrives via onClientBloodDrawGameFinish -->
    <export function="startBloodDrawGame" type="client" />
    <export function="stopBloodDrawGame" type="client" />
    <export function="isBloodDrawGameActive" type="client" />
</meta>
