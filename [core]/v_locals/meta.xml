<meta>
    <info author="DrAndrew112" name="Locals (translator)" type="script" version="1.0.0" />
    <download_priority_group>1001</download_priority_group>

    <!-- Account language is stored in accData "locale.language" (v_mysql).
         The acc_* resources are NOT included on purpose: they consume
         v_locals (login screen), so the dependency must point this way only. -->
    <include resource="v_mysql" />

    <!-- ================= SHARED ================= -->
    <script src="config.lua" type="shared" />
    <script src="shared/catalog.lua" type="shared" />
    <script src="shared/loader.lua" type="shared" />

    <!-- ================= SERVER ================= -->
    <script src="server/players.lua" type="server" />
    <script src="server/validate.lua" type="server" />
    <script src="server/commands.lua" type="server" />
    <script src="server/exports.lua" type="server" />

    <!-- own server instance of the lib as plain scripts (v_locals needs no
         loadstring); server/ready.lua must stay the last server script.
         lib/server.lua is not a <file>: import() reads it on the server. -->
    <script src="lib/utf8x.lua" type="server" />
    <script src="lib/template.lua" type="server" />
    <script src="lib/formats.lua" type="server" />
    <script src="lib/core.lua" type="server" />
    <script src="lib/server.lua" type="server" />
    <script src="server/ready.lua" type="server" />

    <!-- ================= CLIENT ================= -->
    <script src="client/state.lua" type="client" />
    <script src="client/debug.lua" type="client" />
    <script src="client/exports.lua" type="client" />

    <!-- client lib sources: shared/loader.lua concatenates them for import() -->
    <file src="lib/utf8x.lua" />
    <file src="lib/template.lua" />
    <file src="lib/formats.lua" />
    <file src="lib/core.lua" />
    <file src="lib/client.lua" />

