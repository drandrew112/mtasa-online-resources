<meta>
    <info author="DrAndrew112" name="News" version="1.1.0" type="script"
          description="Server news (date, title, text) in MySQL; editor on the v_admin News page, latest news for the login screen and the account menu" />

    <include resource="v_locals" />
    <include resource="v_mysql" />
    <include resource="ui_core" />

    <script src="locals.lua" type="shared" />
    <script src="config.lua" type="shared" />

    <script src="server/store.lua" type="server" />
    <script src="server/editor.lua" type="server" />


    <!-- getLatestNews(n = 5, who) -> { { id, date = unix, author, lang, title, body, texts = { [lang] = { title, body } } }, ... }
                                published ones, newest first. who = player | language code | nil (English):
                                title / body / lang = the reader's language, else its fallback, else English, else the first written;
                                texts = every language of the article (a client can pick again after a language change)
         getAllNews(who)            -> same, every article incl. scheduled (date in the future)
         event onNewsChanged (source = resourceRoot of v_news) after every change or when a scheduled one appears -->
    <export function="getLatestNews" type="server" />
    <export function="getAllNews" type="server" />

    <!-- v_admin News page (the /news editor lives there since v_admin 3.0):
         newsAdminList() -> { list, nowDate, nowTime, languages } | false
         newsAdminSave(author, id | nil, "YYYY.MM.DD", "HH:MM", { [lang] = { title, body } }) -> { ok, message, id }
         newsAdminDelete(author, id) -> { ok, message } -->
    <export function="newsAdminList" type="server" />
    <export function="newsAdminSave" type="server" />
    <export function="newsAdminDelete" type="server" />
</meta>
