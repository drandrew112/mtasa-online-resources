<meta>
    <info author="DrAndrew112" name="Paintjobs" version="1.0.0" type="script"
          description="Custom vehicle paintjobs: paintjobs/model id/name.dds|png|jpg, downloaded on demand, one per vehicle (/paintjobs update)" />

    <script src="config.lua" type="shared" />
    <script src="server.lua" type="server" />
    <script src="client.lua" type="client" />
    <file src="paintjob.fx" />

    <!-- getPaintjobs(model) -> { { name, label } } sorted by name (server + client, same order)
         hasPaintjob(model, name) -> bool
         setVehicleCustomPaintjob(vehicle, name | false) -> bool   (sets primary colour 1 to white, restores it on removal)
         getVehicleCustomPaintjob(vehicle) -> name | false
         previewPaintjob(vehicle, name | false | nil) -> bool      (client, local look; nil ends the preview) -->
    <export function="getPaintjobs"             type="shared" />
    <export function="hasPaintjob"              type="server" />
    <export function="setVehicleCustomPaintjob" type="server" />
    <export function="getVehicleCustomPaintjob" type="server" />
    <export function="previewPaintjob"          type="client" />

    <!-- paintjob <file> entries are generated by /paintjobs update (download="false") -->
</meta>
