<meta>
    <info author="DrAndrew112" name="MySQL Core" type="script" version="2.0.0" />
    <download_priority_group>1000</download_priority_group>

    <!-- Credentials + connection wrapper, then the account-data store. -->
    <script src="config.lua"            type="server" />
    <script src="core/mysql.lua"        type="server" />
    <script src="scripts/connguard.lua" type="server" />
    <script src="scripts/accdata.lua"   type="server" />
    <script src="scripts/asynclib.lua"  type="server" />

    <!-- Freezes everyone with a "database issues" banner instead of letting a
         lost connection stall the server and time every client out. -->
    <script src="client/guard.lua" type="client" />

    <!-- ================= EXPORTS ================= -->
    <!-- Generic MySQL helpers for other resources. Callbacks passed to
         mysqlQuery are only reliable from inside this resource; the *Sync
         helpers block the whole server for the round trip (PERF-01); other
         resources should prefer the async lib (importAsync). -->
    <export function="mysqlQuery"       type="server" />
    <!-- mysqlQueryAsync(eventName, requestId, sql, ...): non-blocking, the
         result comes back as an event on the caller's resource root -->
    <export function="mysqlQueryAsync"  type="server" />
    <!-- mysqlInsertAsync(eventName, requestId, sql, ...): non-blocking INSERT,
         the event carries (requestId, id | false, err) -->
    <export function="mysqlInsertAsync" type="server" />
    <!-- importAsync(): source of the callback-style async lib (MYSQL.query /
         MYSQL.insert / MYSQL.prefetch), see scripts/asynclib.lua -->
    <export function="importAsync"      type="server" />
    <export function="mysqlQuerySync"   type="server" />
    <export function="mysqlInsert"      type="server" />
    <export function="mysqlExec"        type="server" />
    <export function="mysqlEscape"      type="server" />
    <export function="mysqlIsConnected" type="server" />

    <!-- Account data store. This fully replaces MTA's getAccountData /
         setAccountData across the mod. `who` is a player element or an
         account-name string. -->
    <export function="getAccData"   type="server" />
    <export function="setAccData"   type="server" />
    <export function="flushAccData" type="server" />
    <!-- prefetchAccDataAsync(eventName, requestId, names): loads offline
         accounts in one query so the following getAccData calls do not block -->
    <export function="prefetchAccDataAsync" type="server" />
</meta>
