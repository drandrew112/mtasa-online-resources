<meta>
    <info author="DrAndrew112" name="MySQL Core" type="script" version="2.0.0" />
    <download_priority_group>1000</download_priority_group>

    <!-- Credentials + connection wrapper, then the account-data store. -->
    <script src="config.lua"          type="server" />
    <script src="core/mysql.lua"      type="server" />
    <script src="scripts/accdata.lua" type="server" />

    <!-- ================= EXPORTS ================= -->
    <!-- Generic MySQL helpers for other resources. Callbacks passed to
         mysqlQuery are only reliable from inside this resource; the *Sync
         helpers block for the round trip and are safe to call anywhere. -->
    <export function="mysqlQuery"       type="server" />
    <export function="mysqlQuerySync"   type="server" />
    <export function="mysqlInsert"      type="server" />
    <export function="mysqlExec"        type="server" />
    <export function="mysqlEscape"      type="server" />
    <export function="mysqlIsConnected" type="server" />

    <!-- Account data store. This fully replaces MTA's getAccountData /
         setAccountData across the mod. `who` is a player element or an
         account-name string. -->
    <export function="getAccData"   type="server" />
    <export function="setAccData"   type="server" />
    <export function="flushAccData" type="server" />
</meta>
