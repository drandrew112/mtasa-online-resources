<meta>
    <info author="DrAndrew112" name="ModLoader" version="3.0.0" type="script"
          description="ID based model loader: vehicles (manual download), skins, objects, weapons; Settings > Models toggles (/modloader update)" />

    <include resource="v_locals" />

    <script src="config.lua" type="shared" />
    <script src="names.lua" type="server" />
    <script src="server.lua" type="server" />
    <script src="client/state.lua" type="client" />
    <script src="client/load.lua" type="client" />
    <script src="client/download.lua" type="client" />

    <!-- Settings > Models (ui_pause): getModelOption(id) / setModelOption(id, bool)
         getModelStatus(category) -> { ok, total, new, outdated, bytes, totalBytes, names, checking }
         getMissingModels() -> count, bytes, checking   (every "manual" category)
         downloadModels(category) -> bool   isModelDownloadActive() -> bool
         autoUpdate() -> bool   (acc_menu, after the login)
         getLoadProgress() -> done, total, finished, active   (acc_loading screen)
         Local events: onClientModelDownloadStart (category), onClientModelDownloadFinish
         (category, files, failed, cancelled), onClientModelStatusChange -->
    <export function="getModelOption"        type="client" />
    <export function="setModelOption"        type="client" />
    <export function="getModelStatus"        type="client" />
    <export function="getMissingModels"      type="client" />
    <export function="downloadModels"        type="client" />
    <export function="isModelDownloadActive" type="client" />
    <export function="autoUpdate"            type="client" />
    <export function="getLoadProgress"       type="client" />

    <!-- model <file> entries are generated by /modloader update ("manual" categories with download="false") -->
</meta>
