<meta>
    <info author="DrAndrew112" name="ModLoader" version="3.0.0" type="script"
          description="ID based model loader: vehicles, skins, objects, weapons; Settings > Models toggles (/modloader update)" />

    <include resource="v_locals" />

    <script src="config.lua" type="shared" />
    <script src="names.lua" type="server" />
    <script src="server.lua" type="server" />
    <script src="client/state.lua" type="client" />
    <script src="client/load.lua" type="client" />

    <!-- Settings > Models (ui_pause): getModelOption(id) / setModelOption(id, bool)
         getLoadProgress() -> done, total, finished, active   (v_loading screen)
         All model files are normal meta.xml files: MTA downloads them automatically. -->
    <export function="getModelOption"        type="client" />
    <export function="setModelOption"        type="client" />
    <export function="getLoadProgress"       type="client" />

    <!-- event models (events_core): setEventModelEnabled(id, bool) / isEventModelEnabled(id) / getEventModels()
         Keep these here: meta.xml is regenerated from this template by /modloader update. -->
    <export function="setEventModelEnabled"  type="server" />
    <export function="isEventModelEnabled"   type="server" />
    <export function="getEventModels"        type="server" />

    <!-- model <file> entries are generated by /modloader update  -->
</meta>
