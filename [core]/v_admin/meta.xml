<meta>
    <info author="andrasxa" name="v_admin" type="script" version="2.0"
          description="Admin panel (O), admin commands, admin jail and server-side ID manager" />

    <!-- Messages are shown via the ui_core Alert element (chat is disabled) -->
    <include resource="v_locals" />
    <include resource="ui_core" />
    <!-- Player report panel UI (/report) -->
    <include resource="dgs" />
    <!-- /ban -> v_accounts, /mute + /unmute -> v_chat -->
    <include resource="v_accounts" />
    <include resource="v_chat" />
    <!-- admin_level + admin jail data live in the shared accounts table -->
    <include resource="v_mysql" />
    <!-- web admin panel (http://<server>:<httpport>/v_admin/) -->
    <include resource="web_api" />

    <!-- Shared configuration (both sides) -->
    <script src="locals.lua" type="shared" />
    <script src="config.lua" type="shared" />

    <!-- Server side -->
    <script src="server/core.lua"         type="server" />
    <script src="server/id_manager.lua"   type="server" />
    <script src="server/announce.lua"     type="server" />
    <script src="server/admin_manage.lua" type="server" />
    <script src="server/report.lua"       type="server" />
    <script src="server/teleport.lua"     type="server" />
    <script src="server/vehicle.lua"      type="server" />
    <script src="server/jail.lua"         type="server" />
    <script src="server/ban.lua"          type="server" />
    <script src="server/mute.lua"         type="server" />
    <script src="server/misc.lua"         type="server" />
    <script src="server/panel.lua"        type="server" />
    <script src="server/web.lua"          type="server" />

    <!-- Client side -->
    <script src="client/hud.lua"    type="client" />
    <script src="client/noclip.lua" type="client" />
    <script src="client/report.lua" type="client" />
    <!-- Admin panel (O key): core first, then the tabs -->
    <script src="client/panel/core.lua"     type="client" />
    <script src="client/panel/players.lua"  type="client" />
    <script src="client/panel/reports.lua"  type="client" />
    <script src="client/panel/server.lua"   type="client" />
    <script src="client/panel/commands.lua" type="client" />

    <file src="pmalert.mp3" type="client" />

    <!-- ================= WEB ADMIN PANEL =================
         built on web_api: web/http.html sends web/index.html with the css / js inlined.
         HTTP only (not a ui_browser site), so the files are not sent to clients. -->
    <html src="web/http.html" default="true" />
    <file src="web/index.html"    download="false" />
    <file src="web/css/style.css" download="false" />
    <file src="web/js/app.js"     download="false" />

    <!-- web panel API (server/web.lua, first argument = session token) -->
    <export function="adminWebLogin"  type="server" http="true" />
    <export function="adminWebLogout" type="server" http="true" />
    <export function="adminWebState"  type="server" http="true" />
    <export function="adminWebAction" type="server" http="true" />
    <export function="adminWebReport" type="server" http="true" />
    <export function="adminWebLogs"   type="server" http="true" />
</meta>
