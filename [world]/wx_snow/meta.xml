<meta>
    <info author="DrAndrew112" name="wx_snow" version="1.0.0" type="script"
          description="Snow: levels 0-5 from the weekly event (v_admin Weekly > Snow) or /snow, layered world shader (compatible with shader_detail / dynamic_lighting), roof map for covered places, snowfall, fog, colour grading. Never indoors. See DESIGN.md" />

    <min_mta_version client="1.5.8" server="1.5.8" />

    <!-- ================= SHARED ================= -->
    <include resource="v_locals" />
    <script src="locals.lua" type="shared" />
    <script src="shared/config.lua" type="shared" />
    <script src="shared/coverage.lua" type="shared" />

    <!-- ================= SERVER ================= -->
    <script src="server/state.lua"    type="server" />
    <script src="server/commands.lua" type="server" />
    <script src="server/bake.lua"     type="server" />

    <!-- ================= CLIENT ================= -->
    <script src="client/state.lua"   type="client" />
    <script src="client/roofmap.lua" type="client" />
    <script src="client/ground.lua"  type="client" />
    <script src="client/precip.lua"  type="client" />
    <script src="client/env.lua"     type="client" />
    <script src="client/bake.lua"    type="client" />
    <script src="client/debug.lua"   type="client" />
    <script src="client/tests.lua"   type="client" />

    <!-- ================= FILES ================= -->
    <file src="fx/mta-helper.fx" />
