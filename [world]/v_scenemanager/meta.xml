<meta>
    <info author="DrAndrew112" name="Scene Manager" version="2.0.0" type="script"
          description="Scenes from JSON files: vehicles + peds (patients, fighters, hostiles, suspects) with EMS / police tasks by need level, safe scene, auto generator, in-game editor, flagged scene issues" />
    <min_mta_version server="1.5.9" client="1.5.9" />

    <!-- ================= SHARED ================= -->
    <include resource="v_locals" />
    <script src="shared/config.lua" type="shared" />
    <script src="shared/names.lua"  type="shared" />

    <!-- ================= SERVER ================= -->
    <script src="server/util.lua"     type="server" />
    <script src="server/storage.lua"  type="server" />
    <script src="server/builder.lua"  type="server" />
    <script src="server/agencies.lua" type="server" />
    <script src="server/npc.lua"      type="server" />
    <script src="server/safety.lua"   type="server" />
    <script src="server/live.lua"     type="server" />
    <script src="server/variety.lua"  type="server" />
    <script src="server/auto.lua"     type="server" />
    <script src="server/summon.lua"   type="server" />
    <script src="server/issues.lua"   type="server" />
    <script src="server/editor.lua"   type="server" />
    <script src="server/interact.lua" type="server" />
    <script src="server/exports.lua"  type="server" />
    <script src="server/web.lua"      type="server" />

    <!-- ================= CLIENT ================= -->
    <script src="client/editor.lua" type="client" />
    <script src="client/summon.lua" type="client" />
    <script src="client/safety.lua" type="client" />

    <!-- scenes/*.json (+ index.json, issues.json) are read and written by the server only (not downloaded) -->

    <!-- ================= WEB CONSOLE =================
         http://server:httpport/v_scenemanager/ - web/index.html with css / js inlined (web_api) -->
    <html src="index.html" default="true" />
    <export function="vsmWebTexts"  type="server" http="true" />
    <export function="vsmWebLogin"  type="server" http="true" />
    <export function="vsmWebLogout" type="server" http="true" />
    <export function="vsmWebScenes" type="server" http="true" />
    <export function="vsmWebState"  type="server" http="true" />
    <export function="vsmWebSpawn"  type="server" http="true" />
    <export function="vsmWebRemove" type="server" http="true" />
    <export function="vsmWebAuto"   type="server" http="true" />
    <export function="vsmWebFlag"   type="server" http="true" />
    <export function="vsmWebIssues" type="server" http="true" />
    <export function="vsmWebResolveIssue" type="server" http="true" />

    <!-- ================= SETTINGS ================= -->
    <settings>
        <!-- automatic scene generator on/off (also /sceneauto) -->
        <setting name="*autoEnabled" value="true" />
    </settings>

    <!-- ================= EXPORTS ================= -->
    <export function="spawnScene"        type="server" />
    <export function="removeScene"       type="server" />
    <export function="getActiveScenes"   type="server" />
    <export function="getSceneAt"        type="server" />
    <export function="getSceneList"      type="server" />
    <export function="getSceneData"      type="server" />
    <export function="validateSceneData" type="server" />
    <export function="getAutoGenerate"   type="server" />
    <export function="setAutoGenerate"   type="server" />
    <export function="getCatalog"        type="server" />
    <export function="saveSceneData"     type="server" />
    <export function="getSceneIssues"    type="server" />

    <!-- ================= DEPENDENCIES =================
         police_system, ai_peds, navmesh and v_chat are optional (used when they run) -->
    <include resource="med_erm" />
    <include resource="medsys" />
    <include resource="ui_inac" />
    <include resource="ui_core" />
    <include resource="ui_interactobject" />
    <include resource="web_api" />
</meta>
