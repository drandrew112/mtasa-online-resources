<meta>
    <info author="DrAndrew112" name="Claude MCP Bridge" version="1.0.0" type="script"
          description="MTA World MCP bridge: HTTP/JSON API over the live world (inspection, entities, placement, validation, screenshots, medical scenes) for the Node.js MCP server in mcp-server/" />
    <min_mta_version server="1.5.9" client="1.5.9" />

    <!-- The Node.js MCP server (mcp-server/), docs/ and assets/ live in this folder too,
         but MTA only loads the files listed here. -->

    <!-- ================= SHARED ================= -->
    <script src="shared/config.lua"   type="shared" />
    <script src="shared/math.lua"     type="shared" />
    <script src="shared/surfaces.lua" type="shared" />
    <script src="shared/peds.lua"     type="shared" />

    <!-- ================= SERVER ================= -->
    <script src="server/util.lua"       type="server" />
    <script src="server/async.lua"      type="server" />
    <script src="server/probe.lua"      type="server" />
    <script src="server/refs.lua"       type="server" />
    <script src="server/registry.lua"   type="server" />
    <script src="server/props.lua"      type="server" />
    <script src="server/api/status.lua"     type="server" />
    <script src="server/api/player.lua"     type="server" />
    <script src="server/api/world.lua"      type="server" />
    <script src="server/api/models.lua"     type="server" />
    <script src="server/api/entities.lua"   type="server" />
    <script src="server/api/placement.lua"  type="server" />
    <script src="server/api/workspace.lua"  type="server" />
    <script src="server/api/validation.lua" type="server" />
    <script src="server/api/screenshot.lua" type="server" />
    <script src="server/api/scene.lua"      type="server" />
    <script src="server/api/medical.lua"    type="server" />
    <script src="server/api/debug.lua"      type="server" />
    <script src="server/router.lua"     type="server" />
    <script src="server/commands.lua"   type="server" />

    <!-- ================= CLIENT (probe) ================= -->
    <script src="client/probe.lua"    type="client" />
    <script src="client/geometry.lua" type="client" />
    <script src="client/validate.lua" type="client" />
    <script src="client/overlay.lua"  type="client" />
    <script src="client/capture.lua"  type="client" />

    <!-- ================= SETTINGS ================= -->
    <settings>
        <!-- false: only 127.0.0.1 / ::1 may call the HTTP API -->
        <setting name="*allowRemote" value="false" />
        <!-- execute_lua tool (server + probe client code) -->
        <setting name="*allowExec" value="true" />
        <!-- player name that should act as the probe client ("" = automatic) -->
        <setting name="*probePlayer" value="" />
    </settings>

    <!-- ================= HTTP API (one function per category) =================
         POST http://<host>:<httpport>/claude-mcp/call/<category>
         body: [ "<action>", { params }, { meta } ]  -> [ envelope ]           -->
    <export function="status"     type="server" http="true" />
    <export function="player"     type="server" http="true" />
    <export function="camera"     type="server" http="true" />
    <export function="world"      type="server" http="true" />
    <export function="roads"      type="server" http="true" />
    <export function="models"     type="server" http="true" />
    <export function="entities"   type="server" http="true" />
    <export function="placement"  type="server" http="true" />
    <export function="workspace"  type="server" http="true" />
    <export function="scene"      type="server" http="true" />
    <export function="validation" type="server" http="true" />
    <export function="screenshot" type="server" http="true" />
    <export function="medical"    type="server" http="true" />
    <export function="dev"        type="server" http="true" />
    <export function="jobs"       type="server" http="true" />

    <!-- in-process API for other resources: same envelope, synchronous actions only -->
    <export function="callBridge" type="server" />
</meta>
