    <export function="registerWage" type="server" />
    <export function="getWage" type="server" />
    <export function="getWorkPayer" type="server" />
    <export function="getWorkMultiplier" type="server" />
    <export function="getIncomeTaxRate" type="server" />
    <export function="getTaxTarget" type="server" />
    <export function="getFeeTarget" type="server" />

    <!-- VAT (shops: loadstring(exports.v_gov:importVat())(), see shared/vat.lua) + property tax -->
    <export function="importVat" type="server" />
    <export function="importVat" type="client" />
    <export function="getVatRate" type="server" />
    <export function="getVatRates" type="server" />
    <export function="bookVat" type="server" />
    <export function="getPropertyTaxRate" type="server" />

