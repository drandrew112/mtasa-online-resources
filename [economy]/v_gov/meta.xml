<meta>
    <info author="DrAndrew112" name="v_gov" version="1.0.0" type="script"
          description="The state: /gov panel, taxes (hourly company tax, income tax rate keys, VAT, property tax), work pay settings, fees, state healthcare, state companies, votes (/vote)" />

    <include resource="v_locals" />
    <include resource="v_mysql" />
    <include resource="web_api" />

    <!-- ================= SHARED ================= -->
    <script src="locals.lua" type="shared" />
    <script src="shared/config.lua" type="shared" />
    <script src="shared/vat.lua" type="shared" />

    <!-- ================= SERVER ================= -->
    <script src="server/db.lua" type="server" />
    <script src="server/settings.lua" type="server" />
    <script src="server/works.lua" type="server" />
    <script src="server/tax.lua" type="server" />
    <script src="server/health.lua" type="server" />
    <script src="server/vat.lua" type="server" />
    <script src="server/companies.lua" type="server" />
    <script src="server/votes.lua" type="server" />
    <script src="server/news.lua" type="server" />
    <script src="server/budget.lua" type="server" />
    <script src="server/panel.lua" type="server" />
    <script src="server/main.lua" type="server" />

    <!-- ================= CLIENT ================= -->
    <script src="client/panel.lua" type="client" />

    <!-- the /gov page: in game only, opened through web_api's loader (no <html> entry) -->
    <file src="web/index.html" type="client" />
    <file src="web/css/gov.css" type="client" />
    <file src="web/js/gov.js" type="client" />
    <file src="web/vote.html" type="client" />
    <file src="web/js/vote.js" type="client" />

    <!-- settings -->
    <export function="getSetting" type="server" />
    <export function="getFee" type="server" />
    <export function="getCompanyTaxRate" type="server" />
    <export function="getGovRole" type="server" />

