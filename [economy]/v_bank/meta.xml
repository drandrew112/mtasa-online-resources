<meta>
    <info author="DrAndrew112" name="Bank kezelo" version="2.0.0" type="script"
          description="Bank accounts (personal, company, state) in MySQL bank_accounts + bank_ledger, transaction keys, State Treasury" />

    <include resource="v_mysql" />

    <!-- ================= SHARED ================= -->
    <script src="shared/config.lua" type="shared" />
    <script src="shared/keys.lua" type="shared" />

    <!-- ================= SERVER ================= -->
    <script src="server/db.lua" type="server" />
    <script src="server/accounts.lua" type="server" />
    <script src="server/bookings.lua" type="server" />
    <script src="server/migrate.lua" type="server" />
    <script src="server/exports.lua" type="server" />
    <script src="server/queries.lua" type="server" />
    <script src="server/cash.lua" type="server" />
    <script src="server/main.lua" type="server" />

    <!-- ================= CLIENT ================= -->
    <script src="client.lua" type="client" />
    <file src="sounds/pickup_money.wav" />

    <!-- accounts -->
    <export function="isBankReady" type="server" />
    <export function="getTaxableKeys" type="server" />
    <export function="getPlayerAccount" type="server" />
    <export function="getPlayerBalance" type="server" />
    <export function="getCompanyAccount" type="server" />
    <export function="getStateAccount" type="server" />
