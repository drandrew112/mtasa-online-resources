<meta>
    <info author="DrAndrew112" name="v_jobmaps" type="script" version="1.0.0"
          description="Job maps: custom models (dff/col/txd) + objects of a map, files downloaded for everybody but loaded only for the players a job asks for (exports loadJobMap / unloadJobMap)" />

    <min_mta_version server="1.6.0" client="1.6.0" />

    <script src="config.lua" type="shared" />
    <script src="server/main.lua" type="server" />
    <script src="client/main.lua" type="client" />

    <!-- server: loadJobMap(name, players [, options]) -> bool, error
         options = { dimension = 0, interior = 0, offset = { x, y, z } }
         unloadJobMap(name, players) -> bool      unloadAllJobMaps(players) -> number
         getJobMaps() -> { name = { title, center, size, models, objects } }
         getJobMapInfo(name) -> table | false     isJobMapLoaded(name, player) -> bool
         getPlayerJobMaps(player) -> { name, ... }   isJobMapReady(name, player) -> bool
         event onJobMapReady(name) on the player; onJobMapUnloaded(name) -->
    <export function="loadJobMap" type="server" />
    <export function="unloadJobMap" type="server" />
    <export function="unloadAllJobMaps" type="server" />
    <export function="getJobMaps" type="server" />
    <export function="getJobMapInfo" type="server" />
    <export function="isJobMapLoaded" type="server" />
    <export function="isJobMapReady" type="server" />
    <export function="getPlayerJobMaps" type="server" />
    <export function="getJobMapLoadedPlayers" type="server" />
    <!-- client: maps loaded for the local player -->
    <export function="getLoadedJobMaps" type="client" />
    <export function="isJobMapReady" type="client" />

    <!-- client files of the maps, downloaded for everybody (generated by tools/build.py meta);
         .map, map.json and index.json are read by the server only and need no entry -->
