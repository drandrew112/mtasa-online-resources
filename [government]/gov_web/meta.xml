<meta>
    <info author="DrAndrew112" name="gov_web" version="1.0.0" type="script"
          description="Open government website of San Andreas: treasury, budget per state company, tax rates (company, income, VAT, property), fees, healthcare, works, votes. Money data of the last 30 days only." />
    <min_mta_version server="1.6.0" client="1.6.0" />

    <!-- ================= SERVER ================= -->
    <script src="server/api.lua" type="server" />

    <!-- ================= HTTP PAGE =================
         http://<server>:<httpport>/gov_web/ - web/index.html with the css / js inlined (web_api) -->
    <html src="index.html" default="true" />

    <!-- the same page in game (ui_browser site gov.sa, through web_api's loader) -->
    <file src="web/index.html"     type="client" />
    <file src="web/css/gov_web.css" type="client" />
    <file src="web/js/gov_web.js"  type="client" />

    <!-- ================= EXPORTS (web API, read only) ================= -->
    <export function="govWebState" type="server" http="true" />

    <!-- ================= DEPENDENCIES ================= -->
    <include resource="web_api" />
    <include resource="ui_browser" />
    <include resource="v_gov" />
</meta>
