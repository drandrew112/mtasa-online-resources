    <export function="netSave"          type="server" />
    <export function="netReload"        type="server" />
    <export function="netSummary"       type="server" />
    <export function="netListSegments"  type="server" />
    <export function="netValidate"      type="server" />
    <export function="netProject"       type="server" />
    <export function="netPointAt"       type="server" />
    <export function="netAdvance"       type="server" />
    <export function="netGetSwitch"     type="server" />
