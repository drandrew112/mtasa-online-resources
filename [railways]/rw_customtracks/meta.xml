<meta>
    <info author="DrAndrew112" name="Railway custom tracks" version="0.3.0" type="script"
          description="Sunline Rail custom track network (replaces GTA tracks): graph, geometry, trains (puppets), debug drawing. See DESIGN.md" />
    <min_mta_version server="1.6.0" client="1.6.0" />

    <!-- source/ is Lime's old custom train tracks script, kept only as an example (not loaded).
         The network data (data/network/*.json) is read by the server only and sent to the clients. -->

    <!-- ================= SHARED ================= -->
    <script src="shared/config.lua"    type="shared" />
    <script src="shared/geometry.lua"  type="shared" />
    <script src="shared/network.lua"   type="shared" />
    <script src="shared/trainpath.lua" type="shared" />
    <script src="shared/routes.lua"    type="shared" />
    <script src="shared/lines.lua"     type="shared" />

    <!-- ================= SERVER ================= -->
    <script src="server/network.lua"  type="server" />
    <script src="server/validate.lua" type="server" />
    <script src="server/trains.lua"   type="server" />
    <script src="server/switches.lua" type="server" />
    <script src="server/integration.lua" type="server" />

    <!-- ================= CLIENT ================= -->
    <script src="client/network.lua"   type="client" />
    <script src="client/debugdraw.lua" type="client" />
    <script src="client/trains.lua"    type="client" />
    <script src="client/sweeper.lua"   type="client" />
    <script src="client/sounds.lua"    type="client" />
    <script src="client/switches.lua"  type="client" />
    <file src="sounds/run.wav"    type="client" />
    <file src="sounds/brake.wav"  type="client" />
    <file src="sounds/clack.wav"  type="client" />
    <file src="sounds/squeal.wav" type="client" />

