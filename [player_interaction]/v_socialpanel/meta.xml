<meta>
	<info author="DrAndrew112" type="script" name="socialpanel" description="Social panel: friends, profiles, crews, messaging, help" />
	<oop>true</oop>

	<!-- ui_core provides the client export addNotification(title, text) -->
	<include resource="v_locals" />
	<include resource="ui_core" />
	<include resource="v_mysql" />
	<include resource="acc_auth" />

	<script src="locals.lua" type="shared" />
	<script src="shared.lua" type="shared" />

	<script src="c_controls.lua" type="client" cache="false" />
	<script src="c_ui.lua" type="client" cache="false" />
	<script src="c_api.lua" type="client" cache="false" />

	<!-- MySQL layer (crews, messages, friend requests) on top of v_mysql's
	     exports. Schema: database.sql / ../../main.sql. -->
	<script src="db.lua" type="server" />
	<script src="server.lua" type="server" />

	<!-- Crews and all messages live in the shared MySQL database now; friend
	     lists stay in account data. No local XML data files anymore. Run
	     database.sql / ../../main.sql against the DB before first use. -->

	<!-- Social API (client): friends, requests, crews, profiles, messages for other
	     resources (account menu). See c_api.lua for the answer events. -->
	<export function="spRequestSnapshot" type="client" />
	<export function="spFriendAdd" type="client" />
	<export function="spFriendAccept" type="client" />
	<export function="spFriendDecline" type="client" />
	<export function="spFriendRemove" type="client" />
	<export function="spViewProfile" type="client" />
	<export function="spSearch" type="client" />
	<export function="spOpenThread" type="client" />
	<export function="spSendMessage" type="client" />
	<export function="spCrewCreate" type="client" />
	<export function="spCrewJoin" type="client" />
	<export function="spCrewLeave" type="client" />
	<export function="spCrewKick" type="client" />
	<export function="spCrewCustomize" type="client" />
	<export function="spRequestAchievements" type="client" />
</meta>
