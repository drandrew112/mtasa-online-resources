<meta>
    <info author="DrAndrew112" name="ai_land_traffic" version="1.1.0" type="script"
          description="Server-simulated AI road traffic on the navmesh lane network, on the players' expected routes (300 m); navmesh routes for scripted vehicles and GPS destinations; reacts to v_els emergency vehicles" />
    <min_mta_version server="1.6.0" client="1.6.0" />

    <!-- data/runtime/*.dat is navmesh's roads.nav with the same lane / connection ids, prepared by
         tools/build_runtime.py (rerun it after navmesh's tools/build_roads.py). sim.dat is server-only (not downloaded). -->

    <!-- ================= SHARED ================= -->
    <include resource="v_locals" />
    <include resource="navmesh" />
    <script src="locals.lua" type="shared" />
    <script src="shared/config.lua"   type="shared" />
    <script src="shared/geometry.lua" type="shared" />

    <!-- ================= SERVER ================= -->
    <script src="server/network.lua"   type="server" />
    <script src="server/navmesh.lua"   type="server" />
    <script src="server/signals.lua"   type="server" />
    <script src="server/agents.lua"    type="server" />
    <script src="server/obstacles.lua" type="server" />
    <script src="server/lanes.lua"     type="server" />
    <script src="server/els.lua"       type="server" />
    <script src="server/views.lua"     type="server" />
    <script src="server/route.lua"     type="server" />
    <script src="server/sim.lua"       type="server" />
    <script src="server/sync.lua"      type="server" />
    <script src="server/spawner.lua"   type="server" />
    <script src="server/scripted.lua"  type="server" />
    <script src="server/spots.lua"     type="server" />
    <script src="server/chase.lua"     type="server" />
    <script src="server/main.lua"      type="server" />

    <!-- ================= CLIENT ================= -->
    <script src="client/network.lua" type="client" />
    <script src="client/puppets.lua" type="client" />
    <script src="client/reports.lua" type="client" />
    <script src="client/views.lua"   type="client" />
    <script src="client/chase.lua"   type="client" />
    <file src="data/runtime/geo.dat" />

    <!-- ================= EXPORTS ================= -->
    <export function="isTrafficVehicle"      type="server" />
    <export function="getTrafficVehicles"    type="server" />
    <export function="releaseTrafficVehicle" type="server" />
    <export function="setTrafficEnabled"     type="server" />
    <export function="isTrafficEnabled"      type="server" />
    <export function="getTrafficStats"       type="server" />
    <export function="getTrafficLight"       type="server" />
    <export function="setEmergencyDestination" type="server" />

    <!-- scripted vehicles (server/scripted.lua) -->
    <export function="createScriptedVehicle"   type="server" />
    <export function="addScriptedStop"         type="server" />
    <export function="addScriptedTurnPoint"    type="server" />
    <export function="removeScriptedTarget"    type="server" />
    <export function="clearScriptedTargets"    type="server" />
    <export function="continueScriptedVehicle" type="server" />
    <export function="destroyScriptedVehicle"  type="server" />
    <export function="isScriptedVehicle"       type="server" />
    <export function="getScriptedVehicles"     type="server" />
    <export function="getScriptedTargets"      type="server" />
    <export function="getScriptedVehicleState" type="server" />
    <export function="setScriptedPursuit"      type="server" />
    <export function="engageScriptedVehicle"   type="server" />
    <!-- police / service extensions (server/scripted.lua, server/spots.lua, server/chase.lua) -->
    <export function="setScriptedDespawnUnseen" type="server" />
    <export function="setTrafficVehicleFlee"    type="server" />
    <export function="parkScriptedVehicle"      type="server" />
    <export function="adoptTrafficVehicle"      type="server" />
    <export function="pullOverTrafficVehicle"   type="server" />
    <export function="releaseTrafficHold"       type="server" />
    <export function="isTrafficVehicleHeld"     type="server" />
    <export function="findHiddenRoadSpawn"      type="server" />
    <export function="isElementSeenByPlayers"   type="server" />
    <export function="predictRoadPath"          type="server" />
    <export function="getTrafficVehiclePose"    type="server" />
    <export function="setScriptedChase"         type="server" />
    <export function="getScriptedChase"         type="server" />
</meta>
