<meta>
    <info author="DrAndrew112" name="work_atc" version="1.0.0" type="script"
          description="Air traffic controller work on work_core: duty gives ATC rights (tower / approach / radar) of avi_core by work level, optional tower tutorial" />
    <min_mta_version server="1.5.9" client="1.5.9" />

    <include resource="v_locals" />
    <script src="locals.lua" type="shared" />
    <script src="shared/config.lua" type="shared" />
    <script src="server/main.lua"   type="server" />

    <!-- ================= TUTORIAL MODULE (tutorial/, see tutorial/README.md) ================= -->
    <script src="tutorial/config.lua"         type="shared" />
    <script src="tutorial/server/session.lua" type="server" />
    <script src="tutorial/client/card.lua"    type="client" />
    <script src="tutorial/client/steps.lua"   type="client" />
    <file src="tutorial/client/fonts/Roboto.ttf"  type="client" />
    <file src="tutorial/client/fonts/RobotoB.ttf" type="client" />

    <export function="isPlayerATC"        type="server" />
    <export function="getATCPlayers"      type="server" />
    <export function="getATCWorkId"       type="server" />
    <export function="getATCLevelRights"  type="server" />

    <!-- avi_core is used through exports when running (not included, so an avi_core restart does not stop this work);
         the tutorial uses avi_core / avi_controller / avi_traffic / avi_airports the same way -->
    <include resource="work_core" />
</meta>
