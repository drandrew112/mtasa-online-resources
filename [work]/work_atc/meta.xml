<meta>
    <info author="DrAndrew112" name="work_atc" version="1.0.0" type="script"
          description="Air traffic controller work on work_core: duty gives ATC rights (tower / approach / radar) of avi_core by work level, training modules (SCOPE / ADC / APC / ACC)" />
    <min_mta_version server="1.5.9" client="1.5.9" />

    <include resource="v_locals" />
    <script src="locals.lua" type="shared" />
    <script src="shared/config.lua" type="shared" />
    <script src="server/main.lua"   type="server" />

    <!-- ================= TRAINING MODULES SCOPE / ADC / APC / ACC (training/, see training/README.md) ================= -->
    <script src="training/config.lua"          type="shared" />
    <script src="training/server/session.lua"  type="server" />
    <script src="training/server/modules.lua"  type="server" />
    <script src="training/client/card.lua"     type="client" />
    <script src="training/client/core.lua"     type="client" />
    <script src="training/client/scope.lua"    type="client" />
    <script src="training/client/adc.lua"      type="client" />
    <script src="training/client/apc.lua"      type="client" />
    <script src="training/client/acc.lua"      type="client" />
    <script src="training/client/marker.lua"   type="client" />
    <file src="training/client/fonts/Roboto.ttf"  type="client" />
    <file src="training/client/fonts/RobotoB.ttf" type="client" />

    <export function="isPlayerATC"        type="server" />
    <export function="getATCPlayers"      type="server" />
    <export function="getATCWorkId"       type="server" />
    <export function="getATCLevelRights"  type="server" />

    <!-- avi_core is used through exports when running (not included, so an avi_core restart does not stop this work);
         the training uses avi_core / avi_controller / avi_traffic / avi_airports the same way -->
    <include resource="work_core" />
</meta>
