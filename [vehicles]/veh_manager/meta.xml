<meta>
    <info author="DrAndrew112" name="Vehicle Manager" type="script" version="1.0.0"
          description="Central vehicle info: model display names (models.json), forced model colors (vehcolor.json)." />

    <script src="models.lua" type="server" />
    <script src="colors.lua" type="server" />

    <!-- Model id -> display name overrides, loaded by models.lua. -->
    <file src="models.json" download="false" />
    <!-- Model id -> forced colors, loaded and enforced by colors.lua. -->
    <file src="vehcolor.json" download="false" />

    <!-- ================= EXPORTS (server) ================= -->
    <export function="getModelName" type="server" />
    <export function="applyForcedColor" type="server" />
    <export function="getForcedColor"   type="server" />

    <min_mta_version server="1.5.6" />
</meta>
