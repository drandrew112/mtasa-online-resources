<meta>
    <info author="DrAndrew112" name="Owned Vehicles" type="script" version="1.1.0"
          description="Per-account persistent vehicles (MySQL via v_mysql): ownership, spawn points, blips." />

    <!-- Owned vehicles are stored in the shared MySQL database via v_mysql,
         table `vehicles` (schema: database.sql / ../../main.sql). v_accounts
         provides the logged-in identity (getName / isLoggedIn). -->
    <include resource="v_mysql" />
    <include resource="v_accounts" />

    <!-- Config + spawn point tables. spawnpoints.lua is hand-maintained; fill it
         in from the /vehspawn output (vehiclespawnpoints.txt). -->
    <script src="config.lua"      type="server" />
    <script src="spawnpoints.lua" type="server" />
    <script src="models.lua"      type="server" />

    <!-- MySQL layer: row <-> table helpers on top of v_mysql's exports. -->
    <script src="db.lua" type="server" />

    <!-- Runtime: spawn / store, blips, state capture, lifecycle, exports. -->
    <script src="state.lua"    type="server" />
    <script src="server.lua"   type="server" />
    <script src="commands.lua" type="server" />

    <!-- ================= EXPORTS (server) ================= -->
    <!-- Acquisition / removal. This resource never touches money - the caller
         (a shop / sell script) handles that. -->
    <export function="giveVehicle"        type="server" />
    <export function="deleteVehicle"      type="server" />

    <!-- Retrieval. spawnOwnedVehicle puts the car on the nearest free spawn
         point for its type; storeVehicle saves its state and removes it. -->
    <export function="spawnOwnedVehicle"  type="server" />
    <export function="storeVehicle"       type="server" />
    <export function="saveVehicle"        type="server" />

    <!-- isDestroyed gate. setVehicleDestroyed(id, false) is the "unlock". -->
    <export function="setVehicleDestroyed" type="server" />

    <!-- Reads. -->
    <export function="getOwnedVehicles"   type="server" />
    <export function="getVehicleData"     type="server" />
    <export function="isVehicleSpawned"   type="server" />
    <export function="getModelName"       type="server" />
    <export function="getSpawnedVehicleId" type="server" />

    <!-- "Put the current personal vehicle away" - stores whatever the player
         has summoned (wrapper around storeVehicle). -->
    <export function="storePersonalVehicle" type="server" />

    <min_mta_version server="1.5.6" />
</meta>
